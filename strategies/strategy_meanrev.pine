//@version=6
strategy("RSI Bollinger Mean Reversion Template", overlay=true, pyramiding=0, process_orders_on_close=false,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2)

// Generic long-only mean-reversion research template. Defaults are illustrative starting
// points. Tune with your own market, timeframe, costs, and walk-forward tests.

signalGroup = "Signal"
bb_length = input.int(20, "Bollinger length", minval=5, group=signalGroup)
bb_mult = input.float(2.0, "Bollinger multiple", minval=0.5, step=0.1, group=signalGroup)
rsi_length = input.int(14, "RSI length", minval=2, group=signalGroup)
rsi_oversold = input.float(30.0, "RSI oversold", minval=1, maxval=50, group=signalGroup)
use_trend_guard = input.bool(false, "Use trend guard", group=signalGroup)
trend_length = input.int(200, "Trend length", minval=20, group=signalGroup)

riskGroup = "Risk"
stop_type = input.string("Percent", "Stop type", options=["Percent", "ATR", "None"], group=riskGroup)
stop_loss_pct = input.float(8.0, "Stop loss %", minval=0.5, maxval=50, group=riskGroup)
atr_length = input.int(14, "ATR length", minval=1, group=riskGroup)
atr_mult = input.float(2.0, "ATR stop multiple", minval=0.5, group=riskGroup)

exitGroup = "Optional exits"
use_take_profit = input.bool(false, "Use take profit", group=exitGroup)
take_profit_pct = input.float(10.0, "Take profit %", minval=0.5, group=exitGroup)
use_trailing = input.bool(false, "Use trailing stop", group=exitGroup)
trailing_pct = input.float(15.0, "Trailing %", minval=0.5, group=exitGroup)

basis = ta.sma(close, bb_length)
dev = bb_mult * ta.stdev(close, bb_length)
upper = basis + dev
lower = basis - dev
rsi_value = ta.rsi(close, rsi_length)
trend = ta.sma(close, trend_length)
atrv = ta.atr(atr_length)

trend_ok = not use_trend_guard or close > trend
long_cond = close < lower and rsi_value < rsi_oversold and trend_ok
mid_exit = close >= basis

var float entry_price = na
var float peak_high = na

if long_cond and strategy.position_size == 0
    strategy.entry("Long", strategy.long)

if strategy.position_size > 0 and strategy.position_size[1] <= 0
    entry_price := strategy.position_avg_price
    peak_high := high

if strategy.position_size > 0
    peak_high := math.max(nz(peak_high, high), high)
    percent_stop = entry_price * (1 - stop_loss_pct / 100)
    atr_stop = entry_price - atr_mult * atrv
    base_stop = stop_type == "Percent" ? percent_stop : stop_type == "ATR" ? atr_stop : na
    trail_stop = use_trailing ? peak_high * (1 - trailing_pct / 100) : na
    active_stop = na(trail_stop) ? base_stop : na(base_stop) ? trail_stop : math.max(base_stop, trail_stop)
    limit_price = use_take_profit ? entry_price * (1 + take_profit_pct / 100) : na
    strategy.exit("Risk Exit", "Long", stop=active_stop, limit=limit_price)

if mid_exit and strategy.position_size > 0
    strategy.close("Long", comment="Mid-band exit")

if strategy.position_size == 0
    entry_price := na
    peak_high := na

plot(basis, "Middle band", color=color.new(color.gray, 0), linewidth=2)
plot(upper, "Upper band", color=color.new(color.blue, 20), linewidth=1)
plot(lower, "Lower band", color=color.new(color.blue, 20), linewidth=1)
plot(trend, "Trend guard", color=color.new(color.orange, 20), linewidth=1)
bgcolor(long_cond ? color.new(color.green, 90) : na)
plotshape(long_cond, title="Long entry", style=shape.triangleup, location=location.belowbar,
     color=color.new(color.green, 0), size=size.tiny, text="BUY")
plotshape(mid_exit and strategy.position_size > 0, title="Mid-band exit", style=shape.triangledown,
     location=location.abovebar, color=color.new(color.red, 0), size=size.tiny, text="EXIT")

alertcondition(long_cond, "Long entry", "{{ticker}} {{interval}}: mean-reversion LONG at {{close}}")
alertcondition(mid_exit and strategy.position_size > 0, "Mid-band exit", "{{ticker}} {{interval}}: mean-reversion EXIT at {{close}}")

var table info = table.new(position.top_right, 2, 6, border_width=1)
if barstate.islast
    table.cell(info, 0, 0, "Position")
    table.cell(info, 1, 0, strategy.position_size > 0 ? "Long" : "Flat")
    table.cell(info, 0, 1, "RSI")
    table.cell(info, 1, 1, str.tostring(rsi_value, "#.##"))
    table.cell(info, 0, 2, "Lower / Mid")
    table.cell(info, 1, 2, str.tostring(lower, format.mintick) + " / " + str.tostring(basis, format.mintick))
    table.cell(info, 0, 3, "Current")
    table.cell(info, 1, 3, str.tostring(close, format.mintick))
    table.cell(info, 0, 4, "Trend")
    table.cell(info, 1, 4, str.tostring(trend, format.mintick))
    table.cell(info, 0, 5, "Trend OK")
    table.cell(info, 1, 5, trend_ok ? "Yes" : "No")
